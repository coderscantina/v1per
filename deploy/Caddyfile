# Caddy in front of V1Per. Caddy gets and renews a certificate for every domain listed here,
# and passes the Host header through, which V1Per uses to pick the status page.
#
# Add one block per custom status page domain. See docs/guide/install.md.

status.example.com {
	reverse_proxy 127.0.0.1:8080
}

status.customer.example {
	reverse_proxy 127.0.0.1:8080
}
